rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidExercise(ex) {
      return ex in ['squats', 'pushups', 'lunges'];
    }

    function isValidFitnessLevel(level) {
      return level in ['beginner', 'intermediate', 'advanced'];
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'age',
          'fitnessLevel',
          'preferredExercises',
          'workoutGoals',
          'weeklyTrainingTarget',
          'dailyStreak',
          'lastWorkoutDate',
          'bestSquats',
          'bestPushups',
          'bestLunges',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'age',
          'fitnessLevel',
          'preferredExercises',
          'workoutGoals',
          'weeklyTrainingTarget',
          'dailyStreak',
          'lastWorkoutDate',
          'bestSquats',
          'bestPushups',
          'bestLunges',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && data.age is int && data.age >= 10 && data.age <= 110
        && data.fitnessLevel is string && isValidFitnessLevel(data.fitnessLevel)
        && data.preferredExercises is list && data.preferredExercises.size() >= 1 && data.preferredExercises.size() <= 10 && data.preferredExercises[0] is string
        && data.workoutGoals is string && data.workoutGoals.size() <= 300
        && data.weeklyTrainingTarget is int && data.weeklyTrainingTarget >= 1 && data.weeklyTrainingTarget <= 14
        && data.dailyStreak is int && data.dailyStreak >= 0 && data.dailyStreak <= 3650
        && data.lastWorkoutDate is string && data.lastWorkoutDate.size() <= 40
        && data.bestSquats is int && data.bestSquats >= 0 && data.bestSquats <= 5000
        && data.bestPushups is int && data.bestPushups >= 0 && data.bestPushups <= 5000
        && data.bestLunges is int && data.bestLunges >= 0 && data.bestLunges <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkoutSession(data) {
      return data.keys().hasAll([
          'userId',
          'exercise',
          'reps',
          'incompleteReps',
          'durationSeconds',
          'performanceScore',
          'avgConfidence',
          'feedbackSummary',
          'formNotes',
          'minAngle',
          'maxAngle',
          'avgAlignment',
          'isDemo',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'exercise',
          'reps',
          'incompleteReps',
          'durationSeconds',
          'performanceScore',
          'avgConfidence',
          'feedbackSummary',
          'formNotes',
          'minAngle',
          'maxAngle',
          'avgAlignment',
          'isDemo',
          'createdAt'
        ])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.exercise is string && isValidExercise(data.exercise)
        && data.reps is int && data.reps >= 0 && data.reps <= 5000
        && data.incompleteReps is int && data.incompleteReps >= 0 && data.incompleteReps <= 5000
        && data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400
        && data.performanceScore is int && data.performanceScore >= 0 && data.performanceScore <= 100
        && (data.avgConfidence is number) && data.avgConfidence >= 0 && data.avgConfidence <= 1
        && data.feedbackSummary is string && data.feedbackSummary.size() >= 1 && data.feedbackSummary.size() <= 500
        && data.formNotes is list && data.formNotes.size() <= 10 && (data.formNotes.size() == 0 || data.formNotes[0] is string)
        && (data.minAngle is number) && data.minAngle >= 0 && data.minAngle <= 180
        && (data.maxAngle is number) && data.maxAngle >= 0 && data.maxAngle <= 180
        && (data.avgAlignment is number) && data.avgAlignment >= 0 && data.avgAlignment <= 100
        && data.isDemo is bool
        && data.createdAt is timestamp;
    }

    function isValidCoachMessage(data) {
      return data.keys().hasAll(['userId', 'role', 'content', 'createdAt'])
        && data.keys().hasOnly(['userId', 'role', 'content', 'createdAt'])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.role is string && data.role in ['user', 'assistant']
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 4000
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'email',
            'age',
            'fitnessLevel',
            'preferredExercises',
            'workoutGoals',
            'weeklyTrainingTarget',
            'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'dailyStreak',
            'lastWorkoutDate',
            'bestSquats',
            'bestPushups',
            'bestLunges',
            'updatedAt'
          ])
        );
      allow delete: if isValidId(userId) && isOwner(userId);

      match /workouts/{workoutId} {
        allow get: if isValidId(userId) && isValidId(workoutId) && isOwner(userId) && existing().userId == request.auth.uid;
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(workoutId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidWorkoutSession(incoming())
          && incoming().userId == userId
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(workoutId) && isOwner(userId) && existing().userId == request.auth.uid;
      }

      match /coachMessages/{messageId} {
        allow get: if isValidId(userId) && isValidId(messageId) && isOwner(userId) && existing().userId == request.auth.uid;
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(messageId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidCoachMessage(incoming())
          && incoming().userId == userId
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(messageId) && isOwner(userId) && existing().userId == request.auth.uid;
      }
    }
  }
}
